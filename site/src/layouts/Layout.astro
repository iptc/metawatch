---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? 'Metawatch — tracking image metadata across news publishers worldwide.'} />
    <title>{title} — Metawatch</title>
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="brand">
          <a href={`${base}/`}>Metawatch<span class="by-iptc">by IPTC</span></a>
        </div>
        <nav>
          <a href={`${base}/`}>Overview</a>
          <a href={`${base}/countries/`}>Countries</a>
          <a href={`${base}/sites/`}>Sites</a>
          <a href={`${base}/fields/`}>Fields</a>
          <a href={`${base}/cdn/`}>CDN</a>
          <a href={`${base}/c2pa/`}>C2PA</a>
          <a href={`${base}/ai-policy/`}>AI prefs</a>
          <a href={`${base}/dst/`}>Source type</a>
          <a href={`${base}/about/`}>About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>Metawatch</strong> · A project of the
          <a href="https://iptc.org/">International Press Telecommunications Council</a>.<br/>
          Data licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
        </div>
        <div>
          <a href="https://github.com/iptc/metawatch">Source on GitHub</a> ·
          <a href={`${base}/about/`}>Methodology</a> ·
          Publishers may opt out by emailing <a href="mailto:office@iptc.org">office@iptc.org</a>.
        </div>
      </div>
    </footer>
    <script is:inline>
      // Click-to-sort for any <table class="sortable">. Column type
      // (numeric vs string) is auto-detected from the first 10 rows.
      // Re-clicking a header toggles asc ↔ desc. Headers marked
      // data-nosort="true" are skipped.
      (function () {
        function detectNumeric(rows, colIdx) {
          var n = 0, total = 0;
          for (var i = 0; i < Math.min(rows.length, 10); i++) {
            var cell = rows[i].cells[colIdx];
            var t = (cell && cell.textContent || '').trim();
            if (!t || t === '—' || t === '-') continue;
            total++;
            if (!isNaN(parseFloat(t.replace(/[,%\s]/g, '')))) n++;
          }
          return total > 0 && n / total >= 0.75;
        }
        function extractCell(td, isNum) {
          var t = ((td && td.textContent) || '').trim();
          if (!t || t === '—' || t === '-') return isNum ? -Infinity : '';
          if (isNum) {
            var v = parseFloat(t.replace(/[,%\s]/g, ''));
            return isNaN(v) ? -Infinity : v;
          }
          return t.toLowerCase();
        }
        function sortByColumn(table, colIdx, th) {
          var tbody = table.querySelector('tbody');
          if (!tbody) return;
          var rows = Array.prototype.slice.call(tbody.rows);
          var dir = th.classList.contains('sort-asc') ? 'desc' : 'asc';
          var headers = table.querySelectorAll('thead th');
          for (var i = 0; i < headers.length; i++) {
            headers[i].classList.remove('sort-asc', 'sort-desc');
          }
          th.classList.add(dir === 'asc' ? 'sort-asc' : 'sort-desc');
          var isNum = detectNumeric(rows, colIdx);
          rows.sort(function (a, b) {
            var av = extractCell(a.cells[colIdx], isNum);
            var bv = extractCell(b.cells[colIdx], isNum);
            if (av === bv) return 0;
            if (dir === 'asc') return av < bv ? -1 : 1;
            return av < bv ? 1 : -1;
          });
          for (var j = 0; j < rows.length; j++) tbody.appendChild(rows[j]);
        }
        function makeSortable(table) {
          var headers = table.querySelectorAll('thead th');
          for (var i = 0; i < headers.length; i++) (function (th, idx) {
            if (th.dataset && th.dataset.nosort === 'true') return;
            th.classList.add('sortable-col');
            th.setAttribute('tabindex', '0');
            th.setAttribute('role', 'button');
            function act(e) {
              if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
              if (e.preventDefault) e.preventDefault();
              sortByColumn(table, idx, th);
            }
            th.addEventListener('click', act);
            th.addEventListener('keydown', act);
          })(headers[i], i);
        }
        var tables = document.querySelectorAll('table.sortable');
        for (var k = 0; k < tables.length; k++) makeSortable(tables[k]);
      })();
    </script>
  </body>
</html>
