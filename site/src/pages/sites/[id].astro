---
import Layout from '../../layouts/Layout.astro';
import TimeSeriesChart from '../../components/TimeSeriesChart.astro';
import {
  getSites,
  getSiteHistory,
  getSiteFieldStats,
  getSiteFieldHistory,
  getSiteC2pa,
  getSiteDst,
  getSiteSamples,
  getScoring,
  scoreClass,
  countryName,
  categoryLabel,
} from '../../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  const sites = getSites();
  return sites.map(s => ({ params: { id: s.site_id }, props: { site: s } }));
}

const { site } = Astro.props;
const history = getSiteHistory(site.site_id);
const fieldStats = getSiteFieldStats(site.site_id);
const fieldHistory = getSiteFieldHistory(site.site_id);
const c2pa = getSiteC2pa(site.site_id);
const dst = getSiteDst(site.site_id);
const samples = getSiteSamples(site.site_id);
const scoring = getScoring();
const scoredFieldLabels = scoring.scored_fields.map(f => f.label);
// Short labels for the Four-Cs check columns so the table stays narrow.
const shortLabel: Record<string, string> = {
  Creator: 'Cr',
  Copyright: 'Co',
  CaptionDescription: 'Ca',
  CreditLine: 'Cl',
};

// Strip trailing slash for display.
const displayUrl = site.url ? site.url.replace(/\/+$/, '') : '';
---
<Layout title={site.site_name}>
  <p><a href={`${base}/sites/`}>← All sites</a></p>
  <h1>{site.site_name}</h1>
  <p class="lede">
    <a href={`${base}/countries/${site.country.toLowerCase()}/`}>{countryName(site.country)}</a> ·
    <span class={`pill ${site.category}`}>{categoryLabel(site.category)}</span>
    {site.url && (
      <>
        {" · "}
        <a href={site.url} target="_blank" rel="noopener">{displayUrl} ↗</a>
      </>
    )}
  </p>

  <div class="card-row">
    <div class="stat"><span class="stat-label">Articles sampled</span><span class="stat-value">{site.articles_sampled}</span></div>
    <div class="stat"><span class="stat-label">Images analysed</span><span class="stat-value">{site.images_analysed}</span></div>
    <div class="stat"><span class="stat-label">% with IPTC</span><span class="stat-value">{site.pct_with_iptc}%</span></div>
    <div class="stat"><span class="stat-label">Mean IPTC score</span><span class="stat-value">{site.mean_iptc_score.toFixed(1)}</span>
      <span class={`score-bar ${scoreClass(site.mean_iptc_score)}`} style="margin-top:6px;width:140px"><span style={`width:${site.mean_iptc_score}%`}></span></span>
    </div>
  </div>

  {site.status !== 'ok' && (
    <div class="card">
      <strong>Status: {site.status}.</strong>
      {site.status === 'robots_disallow' && <span> The site's robots.txt disallows our crawler.</span>}
      {site.status === 'no_articles_found' && <span> Discovery succeeded but no articles were found in the sample window.</span>}
      {site.status === 'unreachable' && <span> Every feed and sitemap we tried failed at the network layer — usually a CDN or WAF rejecting our requests.</span>}
      {site.status === 'timeout' && <span> The site took longer than 5 minutes to crawl and was cut off.</span>}
      {site.status === 'error' && <span> An unexpected error occurred during the crawl.</span>}
    </div>
  )}

  {history.length >= 2 && (
    <section>
      <h2>Mean IPTC score over time</h2>
      <TimeSeriesChart points={history} yLabel="Score (0–100)" yMax={100} />
    </section>
  )}

  {fieldStats.length > 0 && (
    <section>
      <h2>Field presence</h2>
      <p>
        Population rate of each IPTC field on this site's sampled images.
        The four <strong>scored</strong> fields determine the headline score;
        tracked fields are recorded but don't affect it.
      </p>
      <table>
        <thead>
          <tr>
            <th>Field</th>
            <th>Type</th>
            <th class="num">Present</th>
            <th class="num">Total</th>
            <th class="num">Population</th>
          </tr>
        </thead>
        <tbody>
          {fieldStats.map(f => (
            <tr>
              <td><code>{f.field}</code></td>
              <td>
                {f.scored
                  ? <span class="badge scored">scored</span>
                  : <span class="badge tracked">tracked</span>}
              </td>
              <td class="num">{f.present}</td>
              <td class="num">{f.total}</td>
              <td class="num">
                {f.pct}%
                <span class="bar" aria-hidden="true">
                  <span style={`width:${f.pct}%`}></span>
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {samples.length > 0 && (
    <section>
      <h2>This run's sample</h2>
      <p>
        The articles we picked up from {site.site_name}'s feed in this run,
        plus the lead image we extracted from each. Thumbnails load lazily as
        you scroll. Click an article or image to open it directly.
      </p>
      <table class="samples">
        <thead>
          <tr>
            <th>#</th>
            <th>Image</th>
            <th>Article</th>
            <th class="num">Score</th>
            {scoredFieldLabels.map(l => (
              <th class="num" title={l}>{shortLabel[l] ?? l}</th>
            ))}
            <th class="num">C2PA</th>
            <th>CDN</th>
          </tr>
        </thead>
        <tbody>
          {samples.map((s, i) => (
            <tr>
              <td class="num">{i + 1}</td>
              <td>
                {s.image_url && s.image_http_status === 200
                  ? <a href={s.image_url} target="_blank" rel="noopener">
                      <img src={s.image_url} alt="" class="thumb"
                           loading="lazy" decoding="async" />
                    </a>
                  : <span style="color:var(--iptc-muted)">—</span>}
              </td>
              <td class="article-cell">
                <a href={s.article_url} target="_blank" rel="noopener">
                  {s.title || s.article_url}
                </a>
                {s.publication_date && (
                  <div class="article-date">{s.publication_date.slice(0, 10)}</div>
                )}
              </td>
              <td class="num">
                {s.iptc_score !== undefined
                  ? <span class={`score-pill ${scoreClass(s.iptc_score)}`}>{s.iptc_score.toFixed(0)}</span>
                  : '—'}
              </td>
              {scoredFieldLabels.map(l => {
                const present = s.scored_presence?.[l];
                return (
                  <td class="num" aria-label={present ? `${l}: present` : `${l}: missing`}>
                    {present
                      ? <span class="check">✓</span>
                      : <span class="cross">·</span>}
                  </td>
                );
              })}
              <td class="num">{s.has_c2pa ? <span class="check">✓</span> : <span class="cross">·</span>}</td>
              <td>{s.cdn_provider ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {scoredFieldLabels.some(l => (fieldHistory[l] || []).length >= 2) && (
    <section>
      <h2>Four Cs over time</h2>
      <p>One mini-chart per scored field, showing this site's population rate over crawl runs.</p>
      <div class="four-cs">
        {scoredFieldLabels.map(label => {
          const series = fieldHistory[label] || [];
          return (
            <div class="four-cs-cell">
              <h3>{label}</h3>
              {series.length >= 2 ? (
                <TimeSeriesChart
                  points={series}
                  yLabel="%"
                  yMax={100}
                  format={(n: number) => `${n.toFixed(0)}%`}
                />
              ) : series.length === 1 ? (
                <p style="color:var(--iptc-muted)">
                  Only one run so far — <strong>{series[0].y.toFixed(1)}%</strong> on {series[0].x.slice(0,10)}.
                </p>
              ) : (
                <p style="color:var(--iptc-muted)">No data.</p>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  {c2pa && (
    <section>
      <h2>C2PA on this site</h2>
      <p>
        {c2pa.image_count_with_c2pa} image{c2pa.image_count_with_c2pa === 1 ? '' : 's'}
        carried a <a href="/c2pa/">C2PA</a> manifest in this run. See the
        <a href="/c2pa/">project-wide C2PA page</a> for what each outcome means.
      </p>
      <div class="grid-2">
        <div>
          <h3>Outcomes</h3>
          <table>
            <thead><tr><th>Outcome</th><th class="num">Images</th></tr></thead>
            <tbody>
              {c2pa.by_outcome.map(b => (
                <tr><td><code>{b.outcome}</code></td><td class="num">{b.images}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div>
          <h3>Signer</h3>
          <table>
            <thead><tr><th>Issuer</th><th class="num">Images</th></tr></thead>
            <tbody>
              {c2pa.by_signer.map(s => (
                <tr><td><code>{s.signer}</code></td><td class="num">{s.images}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {dst && (
    <section>
      <h2>Digital source type</h2>
      <p>
        {dst.images_with_dst_iptc > 0 && (
          <>
            {dst.images_with_dst_iptc} image{dst.images_with_dst_iptc === 1 ? '' : 's'} declared a
            DigitalSourceType in XMP.{" "}
          </>
        )}
        {dst.images_with_dst_c2pa > 0 && (
          <>
            {dst.images_with_dst_c2pa} declared one inside a C2PA <code>c2pa.actions</code> assertion.{" "}
          </>
        )}
        See the <a href="/dst/">project-wide source-type page</a> for what the buckets mean.
      </p>
      <div class="grid-2">
        {dst.by_uri_iptc.length > 0 && (
          <div>
            <h3>From IPTC XMP</h3>
            <table>
              <thead><tr><th>Term</th><th>Bucket</th><th class="num">Images</th></tr></thead>
              <tbody>
                {dst.by_uri_iptc.map(r => (
                  <tr>
                    <td><code>{r.term ?? '(unparseable)'}</code></td>
                    <td>{r.bucket}</td>
                    <td class="num">{r.images}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {dst.by_uri_c2pa.length > 0 && (
          <div>
            <h3>From C2PA actions</h3>
            <table>
              <thead><tr><th>Term</th><th>Bucket</th><th class="num">Occurrences</th></tr></thead>
              <tbody>
                {dst.by_uri_c2pa.map(r => (
                  <tr>
                    <td><code>{r.term ?? '(unparseable)'}</code></td>
                    <td>{r.bucket}</td>
                    <td class="num">{r.images}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>
  )}

  <h2>CDN distribution</h2>
  <p>Where this site's images are served from. CDN image-optimization features can strip metadata in transit.</p>
  <table>
    <thead><tr><th>Provider</th><th class="num">Images</th></tr></thead>
    <tbody>
      {Object.entries(site.cdn_breakdown).sort((a,b) => b[1] - a[1]).map(([k, v]) => (
        <tr><td>{k}</td><td class="num">{v}</td></tr>
      ))}
    </tbody>
  </table>

  <h2>Crawl details</h2>
  <div class="card">
    <div><strong>Discovery strategy:</strong> <code>{site.discovery_strategy}</code></div>
    {site.sitemap_url_used && (
      <div>
        <strong>Source URL:</strong>
        {" "}
        <a href={site.sitemap_url_used} target="_blank" rel="noopener"><code>{site.sitemap_url_used}</code></a>
      </div>
    )}
  </div>
</Layout>

<style>
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge.scored {
    background: var(--iptc-green, #6db33f);
    color: white;
  }
  .badge.tracked {
    background: var(--iptc-bar-bg, #eaecef);
    color: var(--iptc-muted, #6b7280);
  }
  .bar {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
    width: 100px;
    height: 6px;
    background: var(--iptc-bar-bg, #eaecef);
    border-radius: 3px;
    overflow: hidden;
  }
  .bar > span {
    display: block;
    height: 100%;
    background: var(--iptc-green, #6db33f);
  }
  table.samples {
    font-size: 0.9rem;
  }
  table.samples th,
  table.samples td {
    padding: 0.5rem 0.6rem;
  }
  .thumb {
    width: 96px;
    height: 64px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    background: var(--iptc-bar-bg, #eaecef);
  }
  .article-cell {
    max-width: 28ch;
    overflow-wrap: anywhere;
  }
  .article-date {
    color: var(--iptc-muted, #6b7280);
    font-size: 0.8rem;
    margin-top: 2px;
  }
  .score-pill {
    display: inline-block;
    min-width: 2.5em;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
    background: var(--iptc-green, #6db33f);
    color: white;
  }
  .score-pill.low {
    background: var(--iptc-bar-bg, #eaecef);
    color: var(--iptc-muted, #6b7280);
  }
  .score-pill.mid {
    background: #f59e0b;
    color: white;
  }
  .check {
    color: var(--iptc-green, #6db33f);
    font-weight: 700;
  }
  .cross {
    color: var(--iptc-bar-bg-strong, #d1d5db);
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }
  .grid-2 h3 {
    margin-top: 0.25rem;
    font-size: 1rem;
  }
  .four-cs {
    display: grid;
    /* 2-up on desktop (content area is ~1050px); collapses to 1-up below ~760px. */
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .four-cs-cell {
    border: 1px solid var(--iptc-bar-bg, #eaecef);
    border-radius: 6px;
    padding: 0.75rem 1rem;
  }
  .four-cs-cell h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
</style>
