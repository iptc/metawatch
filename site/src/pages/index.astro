---
import Layout from '../layouts/Layout.astro';
import TimeSeriesChart from '../components/TimeSeriesChart.astro';
import ScoreCurveChart from '../components/ScoreCurveChart.astro';
import CountryRankChart from '../components/CountryRankChart.astro';
import RankMoveCell from '../components/RankMoveCell.astro';
import { getSummary, getCountries, getSites, getHistory, getScoresForRun, getCountryScoresForRun, getCountryRankings, getLatestCountryRanks, MIN_RANKED_SITES, MIN_RANKED_IMAGES, scoreClass, countryName, categoryLabel } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const summary = getSummary();
const countries = getCountries();
const sites = getSites().filter(s => s.status === 'ok');
const history = getHistory();

const top10Sites = sites.filter(s => s.images_analysed >= MIN_RANKED_IMAGES).slice(0, 10);
// Equal scores share a rank ("8=", "8="), matching how the social graphic
// and the country table treat ties.
const siteRankLabel = (i: number) => {
  const score = top10Sites[i].mean_iptc_score;
  const first = top10Sites.findIndex(t => t.mean_iptc_score === score);
  const tied = top10Sites.filter(t => t.mean_iptc_score === score).length > 1;
  return `${first + 1}${tied ? '=' : ''}`;
};
// Countries are ranked only with more than MIN_RANKED_SITES publishers
// scored, so one or two sites can't carry a country to the top.
const countryRankings = getCountryRankings();
const { ranks: countryRanks, prevRun: prevRankRun } = getLatestCountryRanks();
const top10Countries = countries
  .filter(c => countryRanks.has(c.country))
  .sort((a, b) => countryRanks.get(a.country)!.rank - countryRanks.get(b.country)!.rank)
  .slice(0, 10);
const countryNames = Object.fromEntries(countries.map(c => [c.country, countryName(c.country)]));
const runDate = summary.started_at ? new Date(summary.started_at).toISOString().slice(0, 10) : 'no run yet';

const scorePoints = history.map(h => ({ x: h.started_at, y: h.mean_score }));
const iptcPoints = history.map(h => ({ x: h.started_at, y: h.pct_with_iptc }));

// Rank-ordered score curves for the latest run, with the previous run drawn
// faintly behind for month-on-month comparison of the distribution's shape.
const latestRun = history.length ? history[history.length - 1] : null;
const prevRun = history.length > 1 ? history[history.length - 2] : null;
const runDay = (h: { started_at: string } | null) =>
  h ? new Date(h.started_at).toISOString().slice(0, 10) : '';

const siteScores = latestRun ? getScoresForRun(latestRun.started_at) : [];
const prevSiteScores = prevRun ? getScoresForRun(prevRun.started_at) : null;
const countryScores = latestRun ? getCountryScoresForRun(latestRun.started_at) : [];
const prevCountryScores = prevRun ? getCountryScoresForRun(prevRun.started_at) : null;
const sitesAtZero = siteScores.filter(v => v <= 0).length;
---
<Layout title="Overview">
  <div class="intro-row">
    <div class="intro-text">
      <h1>Metawatch</h1>
      <p class="lede">
        Metawatch tracks how often major news publishers preserve embedded photo metadata
        (Exif, IPTC Photo Metadata (in both original IIM format and newer XMP format), and C2PA) on the images they publish.
        We crawl a curated list of publishers monthly and score the photographs they serve.
      </p>

      <p class="feedback-cta">
        Got a publisher we should add, a metric we're missing, or a number that looks wrong?
        <a href="https://forms.gle/Knhr7ZwvMyEL5MNQA" target="_blank" rel="noopener">Tell us via this short form</a>
        — we read every response.
      </p>
    </div>
    <a href="https://iptc.org/" class="intro-logo-link" target="_blank" rel="noopener" aria-label="IPTC website">
      <img src={`${base}/iptc-logo-gradient.svg`} alt="IPTC" class="intro-logo" />
    </a>
  </div>

  <div class="card-row">
    <a class="stat" href={`${base}/dataset/`}><span class="stat-label">Latest run</span><span class="stat-value">{runDate}</span></a>
    <a class="stat" href={`${base}/sites/`}><span class="stat-label">Sites crawled</span><span class="stat-value">{summary.site_count_succeeded}</span></a>
    <a class="stat" href={`${base}/countries/`}><span class="stat-label">Countries</span><span class="stat-value">{countries.length}</span></a>
    <div class="stat"><span class="stat-label">Images analysed</span><span class="stat-value">{summary.image_count.toLocaleString()}</span></div>
    <div class="stat"><span class="stat-label">Mean IPTC score</span><span class="stat-value">{summary.global_mean_score}</span></div>
    <a class="stat" href={`${base}/fields/`}><span class="stat-label">% with any IPTC</span><span class="stat-value">{summary.pct_with_iptc}%</span></a>
    {summary.pct_with_c2pa > 0 && (
      <a class="stat" href={`${base}/c2pa/`}><span class="stat-label">% with C2PA</span><span class="stat-value">{summary.pct_with_c2pa}%</span></a>
    )}
  </div>

  {summary.run_id === null && (
    <div class="card">
      <strong>No crawl run is available yet.</strong> The site will populate
      once the crawler has produced its first run and the data has been exported.
    </div>
  )}

  {history.length >= 2 && (
    <section>
      <h2>Trends across runs</h2>
      <p>
        Each point is one crawl run. Note that the earlier points are slightly
        skewed, as we crawled fewer publishers in those runs. See the
        <a href={`${base}/dataset/`}> dataset page</a> for the underlying
        parquet files.
      </p>
      <div class="chart-grid">
        <div class="chart-cell">
          <h3>Mean IPTC score</h3>
          <TimeSeriesChart
            points={scorePoints}
            yLabel="Score (0–100)"
            yMax={100}
            format={(n: number) => n.toFixed(1)}
          />
        </div>
        <div class="chart-cell">
          <h3>% of images with any IPTC</h3>
          <TimeSeriesChart
            points={iptcPoints}
            yLabel="% with IPTC"
            yMax={100}
            format={(n: number) => `${n.toFixed(1)}%`}
          />
        </div>
      </div>
    </section>
  )}

  {siteScores.length > 0 && (
    <section>
      <h2>How the scores are distributed</h2>
      <p>
        Every publisher we scored, ranked from best to worst. Any average
        describes almost nobody here: a small group embed metadata thoroughly,
        and <strong>{`${sitesAtZero} of ${siteScores.length}`}</strong> publishers
        embed none we can find at all.
        {prevSiteScores && prevSiteScores.length > 0 && ' The faint line is the previous run.'}
      </p>
      <div class="chart-grid-wide">
        <div class="chart-cell">
          <h3>By publisher</h3>
          <ScoreCurveChart
            scores={siteScores}
            prev={prevSiteScores}
            prevLabel={runDay(prevRun)}
            unit="publishers"
          />
        </div>
        <div class="chart-cell">
          <h3>By country</h3>
          <ScoreCurveChart
            scores={countryScores}
            prev={prevCountryScores}
            prevLabel={runDay(prevRun)}
            unit="countries"
          />
        </div>
      </div>
      <p class="chart-note">
        Covers every publisher that returned at least one image. Publishers we
        reached but got no photograph from are listed separately as
        <a href={`${base}/sites/`}><code>no_images</code></a> rather than scored
        zero, since that is usually our blind spot rather than their practice.
        Country scores are the mean of that country&rsquo;s publishers. The
        dashed line averages these scores one publisher at a time, so it sits a
        little below the <strong>{summary.global_mean_score}</strong> headline
        figure, which weights every image equally instead.
      </p>
    </section>
  )}

  <style>
    /* min() so the track collapses below its ideal width on a phone instead
       of forcing the page to scroll sideways. */
    .chart-grid, .chart-grid-wide {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    }
    /* The curves need more width than the sparklines to stay legible —
       441 lines in 360px is a smear. */
    .chart-grid-wide { grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); }
    .chart-note {
      font-size: 0.85rem;
      color: var(--iptc-muted);
      margin-top: 0.75rem;
    }
    .chart-cell {
      background: var(--iptc-surface);
      border: 1px solid var(--iptc-border);
      border-radius: 6px;
      padding: 0.75rem 1rem 1rem;
    }
    .rank-chart-title {
      margin: 1.5rem 0 0.5rem;
      font-size: 1rem;
      color: var(--iptc-navy);
    }
    .chart-cell h3 {
      margin: 0 0 0.4rem;
      font-size: 1rem;
      color: var(--iptc-navy);
    }
  </style>

  <h2>Top sites</h2>
  <p>Ranked by mean IPTC score across all sampled images in the latest crawl. Only publishers with at least {MIN_RANKED_IMAGES} images sampled are ranked, so a couple of lucky photographs can't put a site at the top.</p>
  <table class="sortable">
    <thead>
      <tr><th class="rank">#</th><th>Site</th><th>Country</th><th>Category</th><th class="num">Images</th><th class="num">% with IPTC</th><th class="num">Score</th></tr>
    </thead>
    <tbody>
      {top10Sites.map((s, i) => (
        <tr>
          <td class="rank">{siteRankLabel(i)}</td>
          <td><a href={`${base}/sites/${s.site_id}/`}>{s.site_name}</a></td>
          <td>{countryName(s.country)}</td>
          <td><span class={`pill ${s.category}`}>{categoryLabel(s.category)}</span></td>
          <td class="num">{s.images_analysed}</td>
          <td class="num">{s.pct_with_iptc}%</td>
          <td class="num">
            <span class={`score-bar ${scoreClass(s.mean_iptc_score)}`}><span style={`width:${s.mean_iptc_score}%`}></span></span>
            {s.mean_iptc_score.toFixed(1)}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p><a href={`${base}/sites/`}>See all sites →</a> · <a href={`${base}/share/top-publishers/`}>Share this ranking as an image →</a></p>

  <h2>Top countries</h2>
  <p>
    Country mean is the average of site scores, equal-weighted per site. Only
    countries with more than {MIN_RANKED_SITES} publishers scored are ranked,
    so a single publisher can't put a country at the top.
    {prevRankRun && <>Movement is against the {runDay({ started_at: prevRankRun })} run.</>}
  </p>
  <table class="sortable">
    <thead>
      <tr><th class="rank">#</th><th>Country</th><th class="num">Sites scored</th><th class="num">Mean score</th><th class="num">Since last run</th></tr>
    </thead>
    <tbody>
      {top10Countries.map(c => {
        const move = countryRanks.get(c.country)!;
        return (
          <tr>
            <td class="rank">{move.rank}</td>
            <td><a href={`${base}/countries/${c.country.toLowerCase()}/`}>{countryName(c.country)}</a></td>
            <td class="num">{c.scored_site_count}</td>
            <td class="num">
              <span class={`score-bar ${scoreClass(c.mean_score)}`}><span style={`width:${c.mean_score}%`}></span></span>
              {c.mean_score.toFixed(1)}
            </td>
            <RankMoveCell move={move} prevLabel={runDay({ started_at: prevRankRun ?? '' })} />
          </tr>
        );
      })}
    </tbody>
  </table>

  {countryRankings.length >= 2 && (
    <>
      <h3 class="rank-chart-title">How this run&rsquo;s top 10 ranked in earlier runs</h3>
      <div class="chart-cell">
        <CountryRankChart
          runs={countryRankings}
          countries={top10Countries.map(c => c.country)}
          names={countryNames}
        />
      </div>
      <p class="chart-note">
        A break in a line means that country wasn&rsquo;t ranked that run —
        usually because too few of its publishers returned images. Earlier
        runs ranked fewer countries, as we tracked fewer publishers. Hover a
        point for its score.
      </p>
    </>
  )}
  <p><a href={`${base}/countries/`}>See all countries →</a> · <a href={`${base}/share/`}>Share this month's rankings as images →</a></p>
</Layout>
