---
import Layout from '../layouts/Layout.astro';
import { getCdn } from '../lib/data';

const cdn = getCdn();
const total = cdn.by_provider.reduce((acc, x) => acc + x.images, 0);
---
<Layout title="CDN analysis">
  <h1>CDN analysis</h1>
  <p class="lede">
    News images are typically served via a content delivery network. Some CDN image-optimisation
    features <strong>can strip embedded metadata</strong> as part of compression — so a publisher
    who carefully embeds IPTC data may still appear to publish "blank" images. This page attributes
    each image we analysed to its CDN, and shows how IPTC retention varies by provider.
  </p>

  <h2>CDN distribution</h2>
  <table class="sortable">
    <thead><tr><th>Provider</th><th class="num">Images</th><th class="num">Share</th><th class="num">% with any IPTC</th></tr></thead>
    <tbody>
      {cdn.by_provider.map(r => (
        <tr>
          <td><code>{r.provider}</code></td>
          <td class="num">{r.images}</td>
          <td class="num">{total ? ((100 * r.images) / total).toFixed(1) : '0.0'}%</td>
          <td class="num">{(100 - r.pct_stripped).toFixed(1)}%</td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>
