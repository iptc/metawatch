---
import Layout from '../../layouts/Layout.astro';
import TimeSeriesChart from '../../components/TimeSeriesChart.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCountryShareCard, shareImagePath, cardAlt } from '../../lib/share-cards';
import { getCountries, getSites, getCountryHistory, getLatestCountryRanks, MIN_RANKED_SITES, scoreClass, countryName, categoryLabel } from '../../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  const countries = getCountries();
  return countries.map(c => ({ params: { cc: c.country.toLowerCase() }, props: { country: c } }));
}

const { country } = Astro.props;
const sites = getSites().filter(s => s.country === country.country);
const history = getCountryHistory(country.country);
const { ranks, prevRun } = getLatestCountryRanks();
const move = ranks.get(country.country);
const shareCard = getCountryShareCard(country.country);
const rankedCount = ranks.size;
const moveText = !move || !prevRun ? null
  : move.delta === null ? `not ranked on ${prevRun.slice(0, 10)}`
  : move.delta === 0 ? `unchanged since ${prevRun.slice(0, 10)}`
  : `${move.delta > 0 ? 'up' : 'down'} ${Math.abs(move.delta)} since ${prevRun.slice(0, 10)}`;
---
<Layout title={countryName(country.country)}>
  <p><a href={`${base}/countries/`}>← All countries</a></p>
  <h1>{countryName(country.country)} <span style="font-weight:400;color:var(--iptc-muted);font-size:0.6em">({country.country})</span></h1>

  <div class="card-row">
    <div class="stat"><span class="stat-label">Sites</span><span class="stat-value">{country.site_count}</span></div>
    <div class="stat"><span class="stat-label">Mean IPTC score</span><span class="stat-value">{country.mean_score.toFixed(1)}</span></div>
    <a class="stat" href={`${base}/countries/`}>
      <span class="stat-label">Rank</span>
      {move ? (
        <span class="stat-value">#{move.rank}<span class="stat-of"> of {rankedCount}</span></span>
      ) : (
        <span class="stat-value stat-of">unranked</span>
      )}
      <span class="stat-sub">{move ? moveText : `needs more than ${MIN_RANKED_SITES} publishers scored`}</span>
    </a>
  </div>

  <style>
    .share-country { display: flex; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap; margin: 1.5rem 0; }
    .share-country img { width: 160px; height: auto; border: 1px solid var(--iptc-border); border-radius: 6px; display: block; }
    .share-country > div { flex: 1; min-width: min(280px, 100%); }
    .share-country h2 { margin-top: 0; }
    .stat-of { font-size: 0.55em; font-weight: 400; color: var(--iptc-muted); }
    .stat-sub { font-size: 0.75rem; color: var(--iptc-muted); }
  </style>

  {history.length >= 2 && (
    <section>
      <h2>Mean IPTC score over time</h2>
      <p>Mean across this country's sites, equal-weighted per site.</p>
      <TimeSeriesChart points={history} yLabel="Score (0–100)" yMax={100} />
    </section>
  )}

  {shareCard && (
    <section class="share-country">
      <a href={`${base}/share/${shareCard.slug}/`}>
        <img src={`${base}${shareImagePath(shareCard)}`} alt={cardAlt(shareCard)} width="1200" height="1500" loading="lazy" />
      </a>
      <div>
        <h2>Share {countryName(country.country)}'s results</h2>
        <p>This month's results for {countryName(country.country)} as an image, sized for LinkedIn and other social feeds.</p>
        <ShareButtons share={shareCard} />
      </div>
    </section>
  )}

  <h2>Sites in {countryName(country.country)}</h2>
  <table class="sortable">
    <thead>
      <tr><th>Site</th><th>Category</th><th>Status</th><th class="num">Images</th><th class="num">% IPTC</th><th class="num">Score</th></tr>
    </thead>
    <tbody>
      {sites.map(s => (
        <tr>
          <td><a href={`${base}/sites/${s.site_id}/`}>{s.site_name}</a></td>
          <td><span class={`pill ${s.category}`}>{categoryLabel(s.category)}</span></td>
          <td>{s.status === 'ok' ? <span>ok</span> : <em>{s.status}</em>}</td>
          <td class="num">{s.images_analysed}</td>
          <td class="num">{s.pct_with_iptc}%</td>
          <td class="num">
            <span class={`score-bar ${scoreClass(s.mean_iptc_score)}`}><span style={`width:${s.mean_iptc_score}%`}></span></span>
            {s.mean_iptc_score.toFixed(1)}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>
