---
import Layout from '../../layouts/Layout.astro';
import CountryMap from '../../components/CountryMap.astro';
import RankMoveCell from '../../components/RankMoveCell.astro';
import { getCountries, getLatestCountryRanks, MIN_RANKED_SITES, scoreClass, countryName } from '../../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const countries = getCountries();
const { ranks, prevRun } = getLatestCountryRanks();
const prevLabel = prevRun ? prevRun.slice(0, 10) : '';
---
<Layout title="Countries">
  <h1>Countries</h1>
  <p class="lede">Per-country mean is the average across the country's sites (equal-weighted per site, regardless of how many images each site contributed). Hover or tap any coloured country on the map to see its score, click to drill in.</p>

  <CountryMap base={base} />

  <p>
    Every country we track is listed, but only those with more than
    {MIN_RANKED_SITES} publishers scored this run get a rank — below that, one
    publisher's habits decide the country's number.
    {prevRun && <>Movement is against the {prevLabel} run; <em>new</em> means
    the country wasn&rsquo;t ranked then.</>}
    <em>Sites</em> counts every publisher we track there; <em>scored</em> counts
    those that returned images this run.
  </p>

  <table class="sortable">
    <thead><tr><th class="rank">#</th><th>Country</th><th class="num">Sites</th><th class="num">Scored</th><th class="num">Mean score</th><th class="num">Since last run</th></tr></thead>
    <tbody>
      {countries.map(c => {
        const move = ranks.get(c.country);
        return (
          <tr>
            <td class="rank">{move ? move.rank : '—'}</td>
            <td><a href={`${base}/countries/${c.country.toLowerCase()}/`}>{countryName(c.country)}</a> <span style="color:var(--iptc-muted)">({c.country})</span></td>
            <td class="num">{c.site_count}</td>
            <td class="num">{c.scored_site_count}</td>
            <td class="num">
              <span class={`score-bar ${scoreClass(c.mean_score)}`}><span style={`width:${c.mean_score}%`}></span></span>
              {c.mean_score.toFixed(1)}
            </td>
            <RankMoveCell move={move} prevLabel={prevLabel} />
          </tr>
        );
      })}
    </tbody>
  </table>
</Layout>
